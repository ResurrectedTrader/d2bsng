# clang-tidy overrides for test code
# Inherits from root .clang-tidy via InheritParentConfig

InheritParentConfig: true

# Extend header filter to also cover test headers (fakes, fixtures, test files).
# The frontend directory is a wildcard ([^\\/]+) so the filter follows a rename of
# tests/frontends/<name>/ instead of quietly matching nothing. pathfinding/reference/
# is left outside it on purpose - adapted third-party code, not ours to restyle. As in
# the root config, the `.*` after d2bsng also matches worktree checkouts
# (d2bsng/.claude/worktrees/<name>/...).
HeaderFilterRegex: '.*d2bsng.*[\\/](src|tests[\\/]frontends[\\/][^\\/]+[\\/](fakes|fixtures|pathfinding[\\/]tests))[\\/].*'

# Disable checks that fire on doctest macros:
# - cert-err58-cpp: TEST_CASE macros create static-duration registrator objects
# - cppcoreguidelines-avoid-non-const-global-variables: same reason
Checks: >
  -cert-err58-cpp,
  -cppcoreguidelines-avoid-non-const-global-variables,
