<?xml version="1.0" encoding="utf-8"?>
<!--
  Imported automatically by MSBuild into every project under this directory,
  before the project body runs - so it works for IDE builds (Visual Studio,
  Rider), which never go through build.ps1, as well as for the command line.

  Its job is to resolve the build-time parameters that would otherwise arrive
  only as `-p:` switches from build.ps1, so an IDE build is not silently a
  different build. Precedence, highest first:

    1. `-p:Name=...` on the MSBuild command line (a global property; build.ps1
       and CI use this, and nothing here can override it)
    2. d2bs.local.props, if present - gitignored, per-developer
    3. the matching environment variable
    4. the default below

  MSBuild surfaces environment variables as properties, which is what makes (3)
  a one-liner and lets the same D2BS_ANALYTICS_KEY that build.ps1 reads apply to
  an IDE build. Note IDEs snapshot the environment at launch: a newly-set user
  variable needs an IDE restart, which is the main reason to prefer (2).
-->
<Project>
  <!-- Copy d2bs.local.props.example to d2bs.local.props to use it. -->
  <Import Project="$(MSBuildThisFileDirectory)d2bs.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)d2bs.local.props')" />

  <PropertyGroup>
    <D2bsAnalyticsKey Condition="'$(D2bsAnalyticsKey)' == ''">$(D2BS_ANALYTICS_KEY)</D2bsAnalyticsKey>
    <!-- Aptabase app key baked into the DLL, so every build reports - not just
         released ones. Committed deliberately: an Aptabase app key is a
         client-side, write-only ingest key, and this one already ships verbatim
         inside every published DLL, so it is not a credential.

         Consequences worth knowing: a fork or a dev build reports into *this*
         project by default. Builds without an explicit -Version carry
         isDebug=true (D2BS_VERSION falls back to "2.0.0-dev"), which buckets
         them apart from release traffic but does not separate them.

         To point a build somewhere else, set D2bsAnalyticsKey via (1)-(3)
         above; to build with analytics compiled out entirely, set it to empty
         (`-p:D2bsAnalyticsKey=`). To leave it compiled in but silent at
         runtime, use -noanalytics / D2BS_ANALYTICS_DISABLE. See
         docs/analytics.md. -->
    <D2bsAnalyticsKey Condition="'$(D2bsAnalyticsKey)' == ''">A-EU-6718352863</D2bsAnalyticsKey>

    <!-- The console's Profiling panel and the counters behind it (utils/Profiling.h).
         Set to false (`-p:D2bsProfiling=false`, build.ps1 -NoProfiling, or
         d2bs.local.props) to compile all of it out: the recording calls become
         empty inline stubs and the panel is not registered. -->
    <D2bsProfiling Condition="'$(D2bsProfiling)' == ''">true</D2bsProfiling>
  </PropertyGroup>

  <!-- The published engines and the published unibind this tree builds against.
       None of them is in the repository: each comes as one archive from a
       GitHub release, which the build downloads on demand (see
       scripts/fetch_archive.ps1). Declaring the versions here rather than in a
       CI step or a README instruction is what makes a fresh clone build
       unattended, and leaves one place to edit for an upgrade.

       The frontend is written against unibind (https://github.com/ResurrectedTrader/unibind)
       and names no engine: it compiles once against unibind's headers, and
       which engine it runs on is decided at the glue link, by which unibind
       backend library and which engine archive that project links. So there
       are three archives - the two engines and unibind - and a project asks for
       the ones it needs.

       Each archive's version and flavor are in the directory it unpacks into,
       and that directory is what the compiler's include path and the linker's
       library path point at. Changing a version changes where every one of
       those points, the archive for the new version is fetched, and headers and
       library cannot be from different builds - not because something checks,
       but because there is no path that expresses the mismatch. The flavor is
       in there too because a debug engine lays some objects out differently
       from a release one, and unibind's debug prefix links the debug engines:
       headers, libraries and CRT all have to agree.

       Old versions are left alone when one is bumped. The engines are hundreds
       of megabytes each, so delete dependencies/<name>/<old version> by hand
       once nothing builds against it.

       EngineToolset is the MSVC toolset all three archives were built with,
       which is part of their names. It is a floor, not a match: any toolset at
       least that new links them, so it is spelled out rather than resolved
       through the releases API - a literal name needs no network round-trip, no
       JSON parsing and no token, and the URL it produces is the same one a
       human would click.

       EngineFlavor follows $(Configuration), which build.ps1, the solution and
       the IDE all supply as a global property, so it is set by the time this
       is evaluated. The engines are x86 only here, because the glue DLLs are;
       unibind follows $(Platform), because its config.h describes the
       architecture and the frontend library builds for x64 as well. Overriding
       an *Asset property is what lets a build point at an archive whose name
       does not follow from the version. -->
  <PropertyGroup>
    <EngineToolset Condition="'$(EngineToolset)' == ''">14.44</EngineToolset>
    <EngineFlavor Condition="'$(EngineFlavor)' == '' And '$(Configuration)' == 'Debug'">debug</EngineFlavor>
    <EngineFlavor Condition="'$(EngineFlavor)' == ''">release</EngineFlavor>

    <V8Version Condition="'$(V8Version)' == ''">15.6.8</V8Version>
    <V8Repo Condition="'$(V8Repo)' == ''">ResurrectedTrader/v8-static-win</V8Repo>
    <V8ReleaseTag Condition="'$(V8ReleaseTag)' == ''">v8-$(V8Version)</V8ReleaseTag>
    <V8Asset Condition="'$(V8Asset)' == ''">v8-$(V8Version)-x86-$(EngineFlavor)-msvc$(EngineToolset).zip</V8Asset>
    <V8Dir Condition="'$(V8Dir)' == ''">$(MSBuildThisFileDirectory)dependencies\v8\$(V8Version)\x86-$(EngineFlavor)</V8Dir>
    <V8IncludeDir>$(V8Dir)\include</V8IncludeDir>

    <SpiderMonkeyVersion Condition="'$(SpiderMonkeyVersion)' == ''">153.3.0esr</SpiderMonkeyVersion>
    <SpiderMonkeyRepo Condition="'$(SpiderMonkeyRepo)' == ''">ResurrectedTrader/spidermonkey-static-win</SpiderMonkeyRepo>
    <SpiderMonkeyReleaseTag Condition="'$(SpiderMonkeyReleaseTag)' == ''">spidermonkey-$(SpiderMonkeyVersion)</SpiderMonkeyReleaseTag>
    <SpiderMonkeyAsset Condition="'$(SpiderMonkeyAsset)' == ''">spidermonkey-$(SpiderMonkeyVersion)-x86-$(EngineFlavor)-msvc$(EngineToolset).zip</SpiderMonkeyAsset>
    <SpiderMonkeyDir Condition="'$(SpiderMonkeyDir)' == ''">$(MSBuildThisFileDirectory)dependencies\spidermonkey\$(SpiderMonkeyVersion)\x86-$(EngineFlavor)</SpiderMonkeyDir>

    <UnibindArch Condition="'$(Platform)' == 'x64'">x64</UnibindArch>
    <UnibindArch Condition="'$(UnibindArch)' == ''">x86</UnibindArch>
    <UnibindVersion Condition="'$(UnibindVersion)' == ''">0.6.3</UnibindVersion>
    <UnibindRepo Condition="'$(UnibindRepo)' == ''">ResurrectedTrader/unibind</UnibindRepo>
    <UnibindReleaseTag Condition="'$(UnibindReleaseTag)' == ''">v$(UnibindVersion)</UnibindReleaseTag>
    <UnibindAsset Condition="'$(UnibindAsset)' == ''">unibind-$(UnibindVersion)-$(UnibindArch)-$(EngineFlavor)-msvc$(EngineToolset).zip</UnibindAsset>
    <UnibindDir Condition="'$(UnibindDir)' == ''">$(MSBuildThisFileDirectory)dependencies\unibind\$(UnibindVersion)\$(UnibindArch)-$(EngineFlavor)</UnibindDir>
    <UnibindIncludeDir>$(UnibindDir)\include</UnibindIncludeDir>
    <UnibindLibDir>$(UnibindDir)\lib</UnibindLibDir>
  </PropertyGroup>

  <!-- Unpack an archive before anything compiles or links against it. A
       project opts in with UnibindRequired (the frontend and the glue DLLs),
       V8Required (the V8 glue) or
       SpiderMonkeyRequired (the SpiderMonkey glue), so the test executable
       fetches nothing.

       The test is the directory, not a file in it: fetch_archive.ps1 extracts
       elsewhere and renames the finished tree into place in one move, so the
       directory either does not exist or is a complete install. A file inside
       it would only say that much of an install got as far as that file.

       Exists() is re-evaluated when the target would run, so a build that
       already has an archive unpacked does not even start PowerShell. -->
  <PropertyGroup>
    <FetchArchive>powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\fetch_archive.ps1&quot;</FetchArchive>
  </PropertyGroup>
  <Target Name="FetchUnibind" BeforeTargets="ClCompile;ResourceCompile;Link" Condition="'$(UnibindRequired)' == 'true'">
    <Exec Condition="!Exists('$(UnibindDir)')"
          Command="$(FetchArchive) -Name unibind -Repo &quot;$(UnibindRepo)&quot; -Tag &quot;$(UnibindReleaseTag)&quot; -Asset &quot;$(UnibindAsset)&quot; -Destination &quot;$(UnibindDir)&quot; -Require include\unibind\unibind.h,include\unibind\config.h,lib\unibind_backend_v8.lib,lib\unibind_backend_spidermonkey.lib -VerifySha256" />
  </Target>
  <Target Name="FetchV8" BeforeTargets="ClCompile;ResourceCompile;Link" Condition="'$(V8Required)' == 'true'">
    <Exec Condition="!Exists('$(V8Dir)')"
          Command="$(FetchArchive) -Name V8 -Repo &quot;$(V8Repo)&quot; -Tag &quot;$(V8ReleaseTag)&quot; -Asset &quot;$(V8Asset)&quot; -Destination &quot;$(V8Dir)&quot; -Require v8_monolith.lib,include\v8.h" />
  </Target>
  <Target Name="FetchSpiderMonkey" BeforeTargets="ClCompile;ResourceCompile;Link" Condition="'$(SpiderMonkeyRequired)' == 'true'">
    <Exec Condition="!Exists('$(SpiderMonkeyDir)')"
          Command="$(FetchArchive) -Name SpiderMonkey -Repo &quot;$(SpiderMonkeyRepo)&quot; -Tag &quot;$(SpiderMonkeyReleaseTag)&quot; -Asset &quot;$(SpiderMonkeyAsset)&quot; -Destination &quot;$(SpiderMonkeyDir)&quot; -Require spidermonkey.lib,include\jsapi.h" />
  </Target>

  <!-- Bake the build-time version into D2BS_VERSION (see core/config/Version.h,
       which #ifndef-guards a dev fallback) and the Aptabase app key into
       D2BS_ANALYTICS_KEY (see services/analytics/Analytics.cpp, which defaults it
       to an empty string that compiles analytics out). Set via `build.ps1
       -Version` / `-AnalyticsKey`, or MSBuild `-p:D2bsVersion=` /
       `-p:D2bsAnalyticsKey=`. The &quot; make the quotes part of the value, so
       each expands to a real string literal. They live here rather than in one
       project because a source file that moves between projects would otherwise
       lose the macro silently. -->
  <ItemDefinitionGroup Condition="'$(D2bsVersion)'!=''">
    <ClCompile>
      <PreprocessorDefinitions>D2BS_VERSION=&quot;$(D2bsVersion)&quot;;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(D2bsAnalyticsKey)'!=''">
    <ClCompile>
      <PreprocessorDefinitions>D2BS_ANALYTICS_KEY=&quot;$(D2bsAnalyticsKey)&quot;;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Every project appends to %(PreprocessorDefinitions), so this reaches all of them. -->
  <ItemDefinitionGroup Condition="'$(D2bsProfiling)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>D2BS_PROFILING;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Compile every project's sources in parallel (the ClangCL toolset turns
       MultiProcessorCompilation into its MultiToolTask scheduler rather than a
       literal /MP). build.ps1 also passes MSBuild -m so independent projects
       (lod114d, js, js_tests) build concurrently; EnforceProcessCountAcrossBuilds
       makes those schedulers share one core-count budget instead of each
       spawning a full set of compilers. -->
  <PropertyGroup>
    <EnforceProcessCountAcrossBuilds>true</EnforceProcessCountAcrossBuilds>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Link-time optimisation. The ClangCL toolset ignores WholeProgramOptimization
       (no /GL equivalent reaches clang-cl), so the projects' Release setting is
       turned into the clang flag here: objects are emitted as bitcode, llvm-lib
       archives them as-is, and lld-link runs the whole-program optimisation at
       link time - which is what lets the one-pointer game:: wrappers inline
       across the static libs. Item definitions are evaluated after every
       project's properties, so the condition sees the project's own value. -->
  <ItemDefinitionGroup Condition="'$(WholeProgramOptimization)' == 'true'">
    <ClCompile>
      <AdditionalOptions>-flto %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
